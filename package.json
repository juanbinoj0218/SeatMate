{
  "name": "seatmate",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:consumer": "npm run dev --workspace=@seatmate/consumer",
    "dev:business": "npm run dev --workspace=@seatmate/business",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:admin": "npm run dev --workspace=@seatmate/admin"
  }
}
