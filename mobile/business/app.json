{
  "expo": {
    "name": "SeatMate Business",
    "slug": "seatmate-business",
    "scheme": "seatmatebusiness",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seatmate360.business",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:seatmate360.net",
        "applinks:www.seatmate360.net"
      ]
    },
    "android": {
      "package": "com.seatmate360.business",
      "adaptiveIcon": {
        "backgroundColor": "#101811",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "seatmate360.net",
              "pathPrefix": "/staff/join/"
            },
            {
              "scheme": "https",
              "host": "www.seatmate360.net",
              "pathPrefix": "/staff/join/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f7f8f5"
        }
      ],
      "expo-apple-authentication"
    ]
  }
}
